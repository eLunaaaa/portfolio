#==================================================
# Build Configuration
# 아래 항목만 프로젝트에 맞게 수정
#==================================================

# 출력될 실행 파일 이름
# 예) sensor, filter, camera
OUTPUT =

# 컴파일할 소스 파일(.c)
# main()이 포함된 소스 파일 1개와
# 기능별 구현(.c) 파일들을 공백으로 나열
#
# 예)
# SRCS = sensor.c imu.c optical_flow.c filter.c
#
SRCS =

# IPC 라이브러리 소스
# 프로젝트 구조가 변경되지 않는 한 수정하지 않음
IPC_SRCS = ../ipc/ipc.c

# IPC 헤더 파일 위치
# 프로젝트 구조가 변경되지 않는 한 수정하지 않음
INCLUDE = -I../ipc

# 실행 파일 출력 위치
# 프로젝트 구조가 변경되지 않는 한 수정하지 않음
OUTDIR = ../test

#==================================================
# Build
#==================================================

all:
	mkdir -p $(OUTDIR)
	$(CC) $(INCLUDE) $(SRCS) $(IPC_SRCS) -o $(OUTDIR)/$(OUTPUT)

#==================================================
# Clean
#==================================================

clean:
	rm -f $(OUTDIR)/$(OUTPUT)

.PHONY: all clean
